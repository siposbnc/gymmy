{
  // Cloudflare Workers static-asset deployment.
  //
  // Gymmy is assets-only: there is no `main` worker script because there is no
  // server side at all — the whole app runs on the device and stores its data
  // in IndexedDB.
  //
  // `not_found_handling: "single-page-application"` is what makes a hard
  // refresh on /history/<id> work. It replaces the `_redirects` approach,
  // which this platform rejects: a `/* -> /index.html 200` rewrite normalises
  // /index.html back to /, which re-matches /*, and the validator correctly
  // flags that as a loop.
  "name": "gymmy",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
