# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.pdf binary

# Generated — collapse in diffs and exclude from language stats
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml    linguist-generated=true -diff
yarn.lock         linguist-generated=true -diff
